{
  "name": "worksense",
  "version": "1.0.0",
  "description": "Personal work time & AI activity tracker",
  "main": "main.js",
  "author": "densivanov",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "node build.js",
    "vendor:fonts": "node vendor-fonts.js",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.21.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "framer-motion": "^11.3.0",
    "htm": "^3.1.1",
    "chart.js": "^4.4.0"
  },
  "build": {
    "appId": "com.densivanov.worksense",
    "productName": "WorkSense",
    "directories": { "output": "release" },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "index.html",
      "assets/**/*",
      "icon.png",
      "icon.ico",
      "package.json"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WorkSense"
    }
  }
}
